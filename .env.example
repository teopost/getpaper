# Copy to .env and adjust. See README.md for details.
URL=http://localhost:3000
PORT=3000

# Only for deploy/docker-compose.yml (published image): database password and image version
POSTGRES_PASSWORD=change-me
GETPAPER_IMAGE=ghcr.io/teopost/getpaper:latest
ALLOW_SIGNUP=true

# Outgoing email for invitations. SMTP_SECURE: ssl (port 465), starttls (587) or none; empty = from the port
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=           # empty: the product name
SMTP_SECURE=

# Accounts that are always superadmins (comma separated). The first account is superadmin anyway.
SUPERADMIN_EMAILS=

# Defaults for users who haven't set their own preference (Settings → Profile)
DEFAULT_LANGUAGE=en          # en | it
DEFAULT_THEME=system         # system | light | dark
DEFAULT_CONTENT_WIDTH=normal # normal | wide | full

# Microsoft Entra ID single sign-on (redirect URI: ${URL}/auth/microsoft/callback)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations
MICROSOFT_ALLOWED_DOMAINS=
MICROSOFT_AUTO_PROVISION=true
# /auth/azure.callback reuses the redirect URI of an Outline instance on the same domain
MICROSOFT_CALLBACK_PATH=/auth/microsoft/callback
PASSWORD_LOGIN=true

# Other single sign-on providers (redirect URI: ${URL}/auth/<google|slack|oidc>/callback).
# *_AUTO_PROVISION empty: accounts are created at the first sign-in when ALLOW_SIGNUP is true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAINS=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_ALLOWED_DOMAINS=
# Any OpenID Connect provider (Keycloak, Okta, Authentik, ...)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=           # on the button, default "OpenID Connect"
OIDC_SCOPES=                 # default "openid profile email"
OIDC_ALLOWED_DOMAINS=
OIDC_TRUST_EMAIL=false       # true: accept emails the provider doesn't mark as verified

# Sign-in with a link sent by email (needs SMTP) and with passkeys
EMAIL_LOGIN=false
PASSKEYS=false
# Webhooks may call addresses of the local network
WEBHOOKS_ALLOW_PRIVATE=false
